# COPY THIS SAME PROJECT FOLDER TO BOTH PCS. Edit .env separately on each PC.
# Mode on YOUR PC with PostgreSQL: HUB
# Mode on the OTHER PC: PEER
MODE=HUB
NODE_ID=NODE_A
PORT=3000
ESP_PORT=COM5

# Both PCs: use the SAME codes / key. Use random secrets, not these placeholders.
MESSAGE_SEND_CODE=CHANGE_ME_SEND_CODE
MESSAGE_VIEW_CODE=CHANGE_ME_VIEW_CODE
GATEWAY_KEY=CHANGE_ME_TO_LONG_RANDOM_SHARED_KEY

# PEER only: URL of YOUR PC on the shared Wi-Fi (replace with actual IPv4).
HUB_URL=http://192.168.1.10:3000

# HUB only: your existing PostgreSQL; PEER does not connect to DB.
DB_HOST=127.0.0.1
DB_PORT=5000
DB_NAME=iot_db
DB_USER=iot_app
DB_PASSWORD=CHANGE_ME_DB_PASSWORD
